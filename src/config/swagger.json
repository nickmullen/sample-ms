    "/exclusionGroups": {
      "get": {
        "tags": [
          "exclusionGroups"
        ],
        "summary": "Get all the exclusion groups",
        "description": "Returns a nested list of all the exclusion groups. Method usually used so that a user can classify a benefit under the right exclusion category",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExclusionGroupArrayResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "exclusionGroups"
        ],
        "summary": "Create a new exclusion group",
        "description": "Create a new exclusion group via UI",
        "operationId": "createExclusionGroup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExclusionGroupTemplate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "successfully created exclusion group",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExclusionGroupResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request / missing languages"
          }
        }
      }
    },
