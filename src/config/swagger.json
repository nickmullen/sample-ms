{
  "openapi": "3.0.3",
  "info": {
    "title": "Sample Service V3",
    "description": "Give a basic template that demonstrates how to run a lightweight microservice that uses mySQL in a way that makes Marcus happy (or at least, less grumpy)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:9000/v1"
    }
  ],
  "tags": [
    {
      "name": "books",
      "description": "Everything about Books",
      "externalDocs": {
        "description": "Find out more",
        "url": "https://reliancehmo.atlassian.net/wiki/spaces/CD/pages/put_a_meaningful_link_here"
      }
    },
    {
      "name": "films",
      "description": "Everything about Films",
      "externalDocs": {
        "description": "Find out more",
        "url": "https://reliancehmo.atlassian.net/wiki/spaces/CD/pages/put_a_meaningful_link_here"
      }
    }
  ],
  "paths": {
    "/books": {
      "get": {
        "tags": [
          "books"
        ],
        "summary": "get all books NOT IMPLEMENTED",
        "description": "Get all books matching a search parameter.  ",
        "operationId": "getBooksBySearch",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 4,
              "maxLength": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookArrayResponse"
                }
              }
            }
          },
          "400": {
            "description": "bad request"
          }
        }
      },
      "post": {
        "tags": [
          "books"
        ],
        "summary": "Create a book",
        "description": "Create a book along with all the required translations",
        "operationId": "addBook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookTemplate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/books/{id}": {
      "get": {
        "tags": [
          "books"
        ],
        "summary": "Get a single benefit",
        "description": "",
        "operationId": "getBenefit",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "unique id of the book",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            }
          },
          "404": {
            "description": "Book not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BookTemplate"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "createdAt": {
                "type": "string",
                "example": "2022-12-01 21:00:00"
              },
              "updatedAt": {
                "type": "string",
                "example": "2022-12-02 12:00:00"
              }
            }
          }
        ]
      },
      "BookArray": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Book"
        }
      },
      "BookArrayResponse": {
        "type": "object",
        "properties": {
          "message": {
            "$ref": "#/components/schemas/Message"
          },
          "books": {
            "$ref": "#/components/schemas/BookArray"
          }
        }
      },
      "BookResponse": {
        "type": "object",
        "properties": {
          "message": {
            "$ref": "#/components/schemas/Message"
          },
          "book": {
            "$ref": "#/components/schemas/Book"
          }
        }
      },
      "BookTemplate": {
        "type": "object",
        "required": [
          "author",
          "names",
          "descriptions"
        ],
        "properties": {
          "author": {
            "type": "string",
            "example": "Joe Smith"
          },
          "names": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranslatedItem"
            }
          },
          "descriptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranslatedItem"
            }
          }
        }
      },
      "Film": {
        "allOf": [
          {
            "$ref": "#/components/schemas/FilmTemplate"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "createdAt": {
                "type": "string",
                "example": "2022-12-01 21:00:00"
              },
              "updatedAt": {
                "type": "string",
                "example": "2022-12-02 12:00:00"
              }
            }
          }
        ]
      },
      "FilmArray": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Film"
        }
      },
      "FilmArrayResponse": {
        "type": "object",
        "properties": {
          "message": {
            "$ref": "#/components/schemas/Message"
          },
          "Films": {
            "$ref": "#/components/schemas/FilmArray"
          }
        }
      },
      "FilmResponse": {
        "type": "object",
        "properties": {
          "message": {
            "$ref": "#/components/schemas/Message"
          },
          "Film": {
            "$ref": "#/components/schemas/Film"
          }
        }
      },
      "FilmTemplate": {
        "type": "object",
        "required": [
          "author",
          "names",
          "descriptions"
        ],
        "properties": {
          "author": {
            "type": "string",
            "example": "Joe Smith"
          },
          "names": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranslatedItem"
            }
          },
          "descriptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranslatedItem"
            }
          }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Success"
          }
        }
      },
      "TranslatedItem": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "example": "en"
          },
          "key": {
            "type": "string",
            "example": "name"
          },
          "value": {
            "type": "string",
            "example": "The name"
          }
        }
      }
    }
  }
}