  },
  "components": {
    "schemas": {
      "BenefitTemplate": {
        "type": "object",
        "required": [
          "snomedCode",
          "names"
        ],
        "properties": {
          "snomed": {
            "type": "string",
            "example": "12345678"
          },
          "names": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Name"
            }
          },
          "benefitGroupId": {
            "type": "string",
            "format": "uuid",
            "example": "2f98dd70-58af-4e6c-a800-e409ca7447b1"
          },
          "exclusionGroupId": {
            "type": "string",
            "format": "uuid",
            "example": "0a889930-6a70-49eb-8295-446d03d89cf3"
          }
        }
      },
      "Benefit": {
        "type": "object",
        "required": [
          "snomedCode",
          "names",
          "createdAt",
          "lastModifiedAt"
        ],
        "properties": {
          "snomedCode": {
            "type": "string",
            "example": "12345678"
          },
          "names": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Name"
            }
          },
          "benefitGroupId": {
            "type": "string",
            "format": "uuid",
            "example": "2f98dd70-58af-4e6c-a800-e409ca7447b1"
          },
          "exclusionGroupId": {
            "type": "string",
            "format": "uuid",
            "example": "0a889930-6a70-49eb-8295-446d03d89cf3"
          },
          "createdAt": {
            "type": "string",
            "example": "2022-12-01 21:00:00"
          },
          "updatedAt": {
            "type": "string",
            "example": "2022-12-02 12:00:00"
          }
        }
      },
      "BenefitArray": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Benefit"
        }
      },
      "BenefitArrayResponse": {
        "type": "object",
        "properties": {
          "message": {
            "$ref": "#/components/schemas/Message"
          },
          "benefits": {
            "$ref": "#/components/schemas/BenefitArray"
          }
        }
      },
      "BenefitResponse": {
        "type": "object",
        "properties": {
          "message": {
            "$ref": "#/components/schemas/Message"
          },
          "benefit": {
            "$ref": "#/components/schemas/Benefit"
          }
        }
      },
      "BenefitGroup": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BenefitGroupTemplate"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "example": "2022-12-01 21:00:00"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "example": "2022-12-02 12:00:00"
              }
            }
          }
        ]
      },
      "BenefitGroupResponse": {
        "type": "object",
        "properties": {
          "message": {
            "$ref": "#/components/schemas/Message"
          },
          "benefitGroup": {
            "$ref": "#/components/schemas/BenefitGroup"
          }
        }
      },
      "BenefitGroupArray": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/BenefitGroup"
        }
      },
      "BenefitGroupArrayResponse": {
        "type": "object",
        "properties": {
          "message": {
            "$ref": "#/components/schemas/Message"
          },
          "benefitGroups": {
            "$ref": "#/components/schemas/BenefitGroupArray"
          }
        }
      },
      "BenefitGroupTemplate": {
        "type": "object",
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Name"
            }
          }
        }
      },
      "ExclusionGroup": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ExclusionGroupTemplate"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "subGroups": {
                "$ref": "#/components/schemas/ExclusionGroupArray"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "example": "2022-12-01 21:00:00"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "example": "2022-12-02 12:00:00"
              }
            }
          }
        ]
      },
      "ExclusionGroupResponse": {
        "type": "object",
        "properties": {
          "message": {
            "$ref": "#/components/schemas/Message"
          },
          "benefitGroup": {
            "$ref": "#/components/schemas/ExclusionGroup"
          }
        }
      },
      "ExclusionGroupArray": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ExclusionGroup"
        }
      },
      "ExclusionGroupArrayResponse": {
        "type": "object",
        "properties": {
          "message": {
            "$ref": "#/components/schemas/Message"
          },
          "benefitGroup": {
            "$ref": "#/components/schemas/ExclusionGroupArray"
          }
        }
      },
      "ExclusionGroupTemplate": {
        "type": "object",
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Name"
            }
          },
          "descriptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Description"
            }
          },
          "parentId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Id of the parent exclusion group"
          }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Success"
          }
        }
      },
      "Name": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Appendectomy"
          },
          "language": {
            "type": "string",
            "example": "en"
          }
        }
      },
      "Description": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "example": "This is a verbose description of Appendectomy"
          },
          "language": {
            "type": "string",
            "example": "en"
          }
        }
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "name": "api_key",
        "in": "header"
      }
    }
  }
}