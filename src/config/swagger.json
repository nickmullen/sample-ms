{
  "openapi": "3.0.3",
  "info": {
    "title": "Benefit Service V3",
    "description": "Benefit Service V3\n\nBenefit V3 adds support for Exclusion Groups\n\nThe Benefit Service V2 is meant to improve on 3 things:\n1. Move the service to prod-ng and prod-eg\n2. Add capabilities to mark benefits as “excluded”\n3. Provide additional capabilities for easier benefit group management",
    "version": "3.0.0"
  },
  "externalDocs": {
    "description": "Find out more about Benefit Service V3 <-- needs updating",
    "url": "https://reliancehmo.atlassian.net/wiki/spaces/CD/pages/410976473/Benefit+Service+V2+Technical+Documentation-UPDATE"
  },
  "servers": [
    {
      "url": "http://localhost:9091/v3"
    }
  ],
  "tags": [
    {
      "name": "benefits",
      "description": "Everything about Benefits",
      "externalDocs": {
        "description": "Find out more",
        "url": "https://reliancehmo.atlassian.net/wiki/spaces/CD/pages/410976473/Benefit+Service+V2+Technical+Documentation"
      }
    },
    {
      "name": "benefitGroups",
      "description": "Everything about Benefit Groups",
      "externalDocs": {
        "description": "Find out more",
        "url": "https://reliancehmo.atlassian.net/wiki/spaces/CD/pages/410976473/Benefit+Service+V2+Technical+Documentation"
      }
    },
    {
      "name": "exclusionGroups",
      "description": "management of exclusionGroups",
      "externalDocs": {
        "description": "Muhammad will update",
        "url": "https://random.com"
      }
    }
  ],
  "paths": {
    "/benefits": {
      "get": {
        "tags": [
          "benefits"
        ],
        "summary": "get benefits matching filter",
        "description": "Get benefits matching a search parameter.  The search parameter must be a minimum of 4 characters long to prevent this returning the whole DB",
        "operationId": "getBenefitBySearch",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 4,
              "maxLength": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenefitArrayResponse"
                }
              }
            }
          },
          "400": {
            "description": "bad request"
          }
        }
      },
      "post": {
        "tags": [
          "benefits"
        ],
        "summary": "add a single benefit",
        "description": "Creation of a new benefit, usually via the TBO service. Ordinarily, you would just know the snomed code and names, however if the benfit group id and the exclusion group id are known, they may optionally be supplied",
        "operationId": "addBenefit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BenefitTemplate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenefitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/benefits/{snomedCode}": {
      "put": {
        "tags": [
          "benefits"
        ],
        "summary": "Update a single benefit",
        "description": "",
        "operationId": "updateBenefit",
        "parameters": [
          {
            "name": "snomedCode",
            "in": "path",
            "description": "Snomed Code of the benefit",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BenefitTemplate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenefitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request body"
          },
          "404": {
            "description": "Benefit not found"
          },
          "409": {
            "description": "SnomedCode in body doesn't match that in path"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "get": {
        "tags": [
          "benefits"
        ],
        "summary": "Get a single benefit",
        "description": "",
        "operationId": "getBenefit",
        "parameters": [
          {
            "name": "snomedCode",
            "in": "path",
            "description": "Snomed Code of the benefit",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenefitResponse"
                }
              }
            }
          },
          "404": {
            "description": "Benefit not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/ungroupedBenefits": {
      "get": {
        "tags": [
          "benefits"
        ],
        "summary": "Get all Ungrouped benefits",
        "description": "",
        "operationId": "ungroupedBenefits",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Number of items per page",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/BenefitArrayResponse"
                      }
                    },
                    "totalPages": {
                      "type": "integer",
                      "example": 1
                    },
                    "totalElements": {
                      "type": "integer",
                      "example": 1
                    },
                    "size": {
                      "type": "integer",
                      "example": 100
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
