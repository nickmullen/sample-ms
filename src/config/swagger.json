    "/benefitGroups/{groupId}/benefits": {
      "get": {
        "tags": [
          "benefitGroups"
        ],
        "summary": "Get all the benefits in a benefit group",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "description": "ID of the benefit group",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenefitArrayResponse"
                }
              }
            }
          },
          "404": {
            "description": "Benefit Group does not exist"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
